FROM golang:1.25-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/service ./cmd/inference-service/

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /bin/service /service
ENTRYPOINT ["/service"]
